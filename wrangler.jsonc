{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-latest",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cc309c39-e079-4a30-9ccf-8f38fe17decc","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6ed9f00fe4864f5fbed290013e092fe3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
